{
    "name": "custobar/custobar_m2_custoconnector",
    "type": "magento2-module",
    "description": "Custobar magento connector",
    "version": "4.0.0",
    "homepage": "https://custobar.com/",
    "license": "MIT",
    "require": {
        "magento/framework": ">=103.0.4"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Custobar\\CustoConnector\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
